# Copie para .env.local e preencha com as chaves do seu projeto Supabase
# (Project Settings > API no painel do Supabase).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só usada em código de servidor (route handlers / server actions). Nunca
# exponha essa chave no cliente.
SUPABASE_SERVICE_ROLE_KEY=
